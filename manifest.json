{
  "manifest_version": 3,
  "name": "Marketplace Listing Helper",
  "version": "1.2.0",
  "description": "Pre-fills Facebook Marketplace listings from a local CSV. You review and press Publish yourself.",
  "permissions": ["storage", "unlimitedStorage"],
  "action": { "default_title": "Open the listing manager" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/*"],
      "js": ["shared.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
